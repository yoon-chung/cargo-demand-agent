# =====================================================================
# .env.example - Cargo Demand Agent
# =====================================================================
# Copy this file to .env and fill in your actual API keys.
# .env is gitignored and will NEVER be committed.
# =====================================================================

# ─── Application Locale ─────────────────────────────────────────────
# Switch between Korean (ko) and English (en) for all user-facing text.
APP_LOCALE=ko

# ─── LLM: Upstage Solar-Pro ─────────────────────────────────────────
# Get from https://console.upstage.ai/
# (Bootcamp provided $17 free credit)
UPSTAGE_API_KEY=up_your_key_here

# ─── Web Search: Tavily ─────────────────────────────────────────────
# Get from https://tavily.com/ (free tier: 1000 calls/month)
TAVILY_API_KEY=tvly_your_key_here

# ─── Logging Level (optional) ───────────────────────────────────────
LOG_LEVEL=INFO
